<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>BuffetSharp.WinForms</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
    <AssemblyTitle>BuffetSharp</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BuffetSharp.Infrastructure\BuffetSharp.Infrastructure.csproj" />
    <!-- Bancos suportados: o escolhido no appsettings.json é carregado em tempo de execução. -->
    <ProjectReference Include="..\BuffetSharp.Infrastructure.SqlServer\BuffetSharp.Infrastructure.SqlServer.csproj" />
    <ProjectReference Include="..\BuffetSharp.Infrastructure.PostgreSql\BuffetSharp.Infrastructure.PostgreSql.csproj" />
    <ProjectReference Include="..\BuffetSharp.Infrastructure.MySql\BuffetSharp.Infrastructure.MySql.csproj" />
    <ProjectReference Include="..\BuffetSharp.Infrastructure.Oracle\BuffetSharp.Infrastructure.Oracle.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BuffetSharp.Tests.Telas" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.Drawing" />
    <Using Include="System.Windows.Forms" />
  </ItemGroup>

</Project>
